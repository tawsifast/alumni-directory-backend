
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Alumni {
  id              String   @id @default(uuid())
  fullName        String
  email           String   @unique
  graduationYear  Int
  department      String
  currentCompany  String?
  currentPosition String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
