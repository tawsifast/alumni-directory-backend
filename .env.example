# PostgreSQL connection string (Neon or Supabase)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Frontend Next.js application URL (used for CORS and JWKS retrieval)
# In local development: http://localhost:3000
# In Vercel production: https://<your-frontend-app>.vercel.app
FRONTEND_URL=http://localhost:3000

# Better Auth URL (matches frontend URL)
BETTER_AUTH_URL=http://localhost:3000

# Optional custom JWKS URL override (defaults to ${FRONTEND_URL}/api/auth/jwks)
# JWKS_URL=https://<your-frontend-app>.vercel.app/api/auth/jwks

# Server port (used for local development)
PORT=5000
